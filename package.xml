<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>domain_fleet_gateway</name>
  <version>0.1.0</version>
  <description>Fleet gateway for ROS 2 domain-isolated multi-robot systems.</description>
  <maintainer email="region@todo.todo">region</maintainer>
  <license>Apache-2.0</license>
  <url type="website">https://github.com/region/domain_fleet_gateway</url>
  <url type="repository">https://github.com/region/domain_fleet_gateway</url>
  <url type="bugtracker">https://github.com/region/domain_fleet_gateway/issues</url>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>map_msgs</exec_depend>
  <exec_depend>rosapi</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>domain_bridge</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
